NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_h-c5CMtzOuUoYPHhWqq-VQ_Fhmv8KBC

# Clave de API de Google Maps Platform (geolocalización, distancias y geocercas)
