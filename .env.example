# =====================================================================
# BUMAND - Variables de Entorno del Frontend (Next.js App Router)
# =====================================================================

# URL base del API Backend NestJS (escritorio local: http://localhost:3002 | Vercel: https://bummand-backend.vercel.app)
NEXT_PUBLIC_API_URL=http://localhost:3002

# Habilitar Socket.IO en tiempo real (true en escritorio/servidor dedicado, false en Vercel Serverless)
NEXT_PUBLIC_WS_ENABLED=true

# Configuración pública de Supabase
